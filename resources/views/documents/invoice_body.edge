<style>
  .invoice-meta { width: 100%; margin-bottom: 4mm; }
  .invoice-meta td { padding: 0.5mm 0; }
  .invoice-lines, .invoice-summary { width: 100%; border-collapse: collapse; margin-top: 4mm; }
  .invoice-lines th, .invoice-lines td, .invoice-summary th, .invoice-summary td { padding: 2mm 1.5mm; border-bottom: 0.2mm solid #d0d7de; text-align: left; vertical-align: top; }
  .invoice-lines th, .invoice-summary th { font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.03em; color: #57606a; }
  .num { text-align: right !important; white-space: nowrap; }
  .invoice-lines tr { page-break-inside: avoid; }
  .invoice-totals { margin-top: 4mm; margin-left: auto; }
  .invoice-totals td { padding: 0.8mm 1.5mm; }
  .invoice-totals .grand td { font-size: 12pt; font-weight: bold; border-top: 0.3mm solid #24292f; }
  .invoice-note { margin-top: 5mm; white-space: pre-line; }
  .invoice-legal { margin-top: 5mm; font-size: 8.5pt; color: #57606a; }
</style>

<table class="invoice-meta">
  <tr><td>{{ t('documents.invoice.number') }}</td><td><strong>{{ number }}</strong></td></tr>
  <tr><td>{{ t('documents.invoice.issuedOn') }}</td><td>{{ issuedOn }}</td></tr>
  <tr><td>{{ t('documents.invoice.dueOn') }}</td><td>{{ dueOn }}</td></tr>
  <tr><td>{{ t('documents.invoice.paymentMethod') }}</td><td>{{ payment }}</td></tr>
</table>

<table class="invoice-lines">
  <thead>
    <tr>
      <th>{{ t('documents.invoice.description') }}</th>
      <th class="num">{{ t('documents.invoice.quantity') }}</th>
      <th class="num">{{ t('documents.invoice.unitPrice') }}</th>
      <th class="num">{{ t('documents.invoice.discount') }}</th>
      <th class="num">{{ t('documents.invoice.vat') }}</th>
      <th class="num">{{ t('documents.invoice.amount') }}</th>
    </tr>
  </thead>
  <tbody>
    @each(line in lines)
      <tr>
        <td>{{ line.description }}</td>
        <td class="num">{{ line.quantity }}</td>
        <td class="num">{{ line.unitPrice }}</td>
        <td class="num">{{ line.discount }}</td>
        <td class="num">{{ line.vat }}</td>
        <td class="num">{{ line.amount }}</td>
      </tr>
    @end
  </tbody>
</table>

<table class="invoice-summary">
  <thead>
    <tr>
      <th>{{ t('documents.invoice.vat') }}</th>
      <th class="num">{{ t('documents.invoice.taxable') }}</th>
      <th class="num">{{ t('documents.invoice.vatAmount') }}</th>
    </tr>
  </thead>
  <tbody>
    @each(row in summary)
      <tr>
        <td>{{ row.vat }}</td>
        <td class="num">{{ row.taxable }}</td>
        <td class="num">{{ row.vatAmount }}</td>
      </tr>
    @end
  </tbody>
</table>

<table class="invoice-totals">
  @if(discount)
    <tr><td>{{ t('documents.invoice.globalDiscount') }}</td><td class="num">{{ discount }}</td></tr>
  @end
  <tr><td>{{ t('documents.invoice.taxable') }}</td><td class="num">{{ taxable }}</td></tr>
  <tr><td>{{ t('documents.invoice.vatAmount') }}</td><td class="num">{{ vat }}</td></tr>
  <tr class="grand"><td>{{ t('documents.invoice.total') }}</td><td class="num">{{ total }}</td></tr>
</table>

@if(notes)
  <p class="invoice-note">{{ notes }}</p>
@end

@each(note in legalNotes)
  <p class="invoice-legal">{{ note }}</p>
@end

<p class="invoice-legal">{{ t('documents.invoice.courtesyCopy') }}</p>
