<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <title>{{ title }}</title>
    <style>
      @page {
        size: A4;
        margin: 16mm 14mm 18mm;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: 'Helvetica Neue', Arial, 'Liberation Sans', sans-serif;
        font-size: 9.5pt;
        line-height: 1.4;
        color: #1f2328;
      }
      h1 {
        font-size: 14pt;
        margin: 0 0 5mm;
      }
      h2 {
        font-size: 9pt;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #57606a;
        margin: 5mm 0 1.5mm;
      }
      .parties {
        display: flex;
        gap: 10mm;
      }
      .parties > section {
        flex: 1;
      }
      .name {
        font-weight: 700;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th,
      td {
        padding: 1.5mm 1.5mm;
        border-bottom: 0.2mm solid #d0d7de;
        text-align: left;
        vertical-align: top;
      }
      th {
        font-size: 8pt;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #57606a;
      }
      tr {
        page-break-inside: avoid;
      }
      .num {
        text-align: right;
        white-space: nowrap;
      }
      .description {
        white-space: pre-line;
      }
      .meta td,
      .totals td {
        border: none;
        padding: 0.5mm 1.5mm 0.5mm 0;
      }
      .meta td:first-child {
        width: 42mm;
        color: #57606a;
      }
      .totals {
        width: auto;
        margin: 3mm 0 0 auto;
      }
      .totals .grand td {
        font-size: 11pt;
        font-weight: 700;
        border-top: 0.3mm solid #24292f;
      }
      .note {
        margin-top: 6mm;
        font-size: 8pt;
        color: #57606a;
      }
    </style>
  </head>
  <body>
    <h1>{{ title }}</h1>

    <table class="meta">
      <tr>
        <td>{{ t('ui.supplierInvoices.documentType') }}</td>
        <td>{{ documentType }}</td>
      </tr>
      <tr>
        <td>{{ t('ui.supplierInvoices.number') }}</td>
        <td><strong>{{ number }}</strong></td>
      </tr>
      <tr>
        <td>{{ t('ui.supplierInvoices.issuedOn') }}</td>
        <td>{{ issuedOn }}</td>
      </tr>
      @if(currency !== 'EUR')
        <tr>
          <td>{{ t('ui.supplierInvoices.currency') }}</td>
          <td>{{ currency }}</td>
        </tr>
      @end
      @if(sdiIdentifier)
        <tr>
          <td>{{ t('ui.supplierInvoices.sdiIdentifier') }}</td>
          <td>{{ sdiIdentifier }}</td>
        </tr>
      @end
      @each(note in notes)
        <tr>
          <td>{{ t('ui.supplierInvoices.notes') }}</td>
          <td class="description">{{ note }}</td>
        </tr>
      @end
    </table>

    <div class="parties">
      <section data-test="seller">
        <h2>{{ t('ui.supplierInvoices.seller') }}</h2>
        <div class="name">{{ seller.name }}</div>
        @each(line in seller.addressLines)
          <div>{{ line }}</div>
        @end

        <div>{{ t('ui.supplierInvoices.vatId') }} {{ seller.vatId }}</div>
        @if(seller.taxCode)
          <div>{{ t('ui.supplierInvoices.taxCode') }} {{ seller.taxCode }}</div>
        @end
      </section>
      <section data-test="buyer">
        <h2>{{ t('ui.supplierInvoices.buyer') }}</h2>
        <div class="name">{{ buyer.name }}</div>
        @if(buyer.vatNumber)
          <div>{{ t('ui.supplierInvoices.vatId') }} {{ buyer.vatNumber }}</div>
        @end
        @if(buyer.taxCode)
          <div>{{ t('ui.supplierInvoices.taxCode') }} {{ buyer.taxCode }}</div>
        @end
      </section>
    </div>

    <h2>{{ t('ui.supplierInvoices.lines') }}</h2>
    <table>
      <thead>
        <tr>
          <th>{{ t('ui.supplierInvoices.lineNumber') }}</th>
          <th>{{ t('ui.supplierInvoices.code') }}</th>
          <th>{{ t('ui.supplierInvoices.lineDescription') }}</th>
          <th class="num">{{ t('ui.supplierInvoices.quantity') }}</th>
          <th class="num">{{ t('ui.supplierInvoices.unitPrice') }}</th>
          <th class="num">{{ t('ui.supplierInvoices.lineTotal') }}</th>
          <th class="num">{{ t('ui.supplierInvoices.vatRate') }}</th>
        </tr>
      </thead>
      <tbody>
        @each(line in lines)
          <tr>
            <td>{{ line.lineNumber }}</td>
            <td>{{ line.code }}</td>
            <td class="description">{{ line.description }}</td>
            <td class="num">{{ line.quantity }}</td>
            <td class="num">{{ line.unitPrice }}</td>
            <td class="num">{{ line.total }}</td>
            <td class="num">{{ line.vat }}</td>
          </tr>
        @end
      </tbody>
    </table>

    <h2>{{ t('ui.supplierInvoices.summary') }}</h2>
    <table>
      <thead>
        <tr>
          <th>{{ t('ui.supplierInvoices.vatRate') }}</th>
          <th class="num">{{ t('ui.supplierInvoices.taxable') }}</th>
          <th class="num">{{ t('ui.supplierInvoices.vat') }}</th>
          <th>{{ t('ui.supplierInvoices.reference') }}</th>
        </tr>
      </thead>
      <tbody>
        @each(row in summary)
          <tr>
            <td>{{ row.vat }}</td>
            <td class="num">{{ row.taxable }}</td>
            <td class="num">{{ row.vatAmount }}</td>
            <td>{{ row.reference }}</td>
          </tr>
        @end
      </tbody>
    </table>

    <table class="totals">
      <tr>
        <td>{{ t('ui.supplierInvoices.taxable') }}</td>
        <td class="num">{{ taxable }}</td>
      </tr>
      <tr>
        <td>{{ t('ui.supplierInvoices.vat') }}</td>
        <td class="num">{{ vat }}</td>
      </tr>
      <tr class="grand">
        <td>{{ t('ui.supplierInvoices.total') }}</td>
        <td class="num">{{ total }}</td>
      </tr>
    </table>
    @if(payments.length)
      <h2>{{ t('ui.supplierInvoices.payments') }}</h2>
      <table>
        <thead>
          <tr>
            <th>{{ t('ui.supplierInvoices.paymentMethod') }}</th>
            <th>{{ t('ui.supplierInvoices.dueOn') }}</th>
            <th>{{ t('ui.supplierInvoices.iban') }}</th>
            <th class="num">{{ t('ui.supplierInvoices.amount') }}</th>
          </tr>
        </thead>
        <tbody>
          @each(payment in payments)
            <tr>
              <td>{{ payment.method }}</td>
              <td>{{ payment.dueOn }}</td>
              <td>{{ payment.iban }}</td>
              <td class="num">{{ payment.amount }}</td>
            </tr>
          @end
        </tbody>
      </table>
    @end

    <p class="note">{{ t('documents.supplierInvoice.rendering', { file: fileName }) }}</p>
  </body>
</html>
