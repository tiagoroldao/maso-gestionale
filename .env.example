# Node
TZ=Europe/Rome
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (host port mapped by compose.yaml)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=maso
DB_PASSWORD=maso
DB_DATABASE=maso

# PDF conversion (host port mapped by compose.yaml)
GOTENBERG_URL=http://127.0.0.1:3010

# Released image to run with Compose (see README → Releases); "latest" by default
# APP_VERSION=1.0.0

# Nightly backup time, HH:mm in Europe/Rome (backup service); 01:30 by default
# BACKUP_TIME=01:30
